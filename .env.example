# Copy to .env and fill in. .env is gitignored.
#
# Only VITE_-prefixed variables are bundled into the browser app; everything
# else in this file is read solely by scripts/deploy.mjs.

# ---------------------------------------------------------------------------
# Public — shipped to the browser
# ---------------------------------------------------------------------------

VITE_HAPPYVIEW_URL=https://view.sharedcomputer.network

# Public API client key (hvc_).
VITE_HV_CLIENT_KEY=hvc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Must be a loopback IP for dev (atproto rejects the `localhost` hostname in
# redirect URIs) and must match the SDK callback path exactly.
VITE_OAUTH_REDIRECT_URI=http://127.0.0.1:5173/oauth/callback

# Every scope listed here must ALSO be enabled on the API client in the
# HappyView dashboard. Either side alone fails silently at the consent screen.
# update covers the rkey=self putRecord path; delete covers withdraw. The
# admin.list scope only matters for the session that maintains the roster.
VITE_OAUTH_SCOPE=atproto transition:email repo:network.sharedcomputer.membership.request?action=create&action=update&action=delete repo:network.sharedcomputer.admin.list?action=create&action=update

# The service DID whose repo anchors the admin roster (public info).
VITE_SERVICE_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx

# The registry space, created from the admin page once the service identity
# signs in. Leave blank until then; deploy skips unset variables.
VITE_REGISTRY_SPACE_URI=

# How many gateway keys one member may hold.
MAX_KEYS_PER_MEMBER=10

# ---------------------------------------------------------------------------
# Deploy only secrets.
# ---------------------------------------------------------------------------

# Admin API key (hv_) from the HappyView dashboard. Needs permissions for
# lexicons, scripts, script variables, settings, and backfill.
HAPPYVIEW_API_KEY=hv_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pushed to HappyView as Lua script variables.
LITELLM_BASE_URL=https://my.litellm-gateway.com
LITELLM_PROVISIONER_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# Sole admin until a roster record exists, so the first roster can be written.
BOOTSTRAP_ADMIN_DID=did:plc:xxxxxxxxxxxxxxxxxxxxxxxx
