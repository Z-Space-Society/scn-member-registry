{
  "lexicon": 1,
  "id": "network.sharedcomputer.admin.approveMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Approve a membership application. Caller must be a current admin in the roster. Provisions the LiteLLM user (idempotent: user_id is the DID), and writes the grant to the registry space authored by the calling admin.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "teamId": {
              "type": "string",
              "description": "LiteLLM team ID."
            },
            "teamLabel": {
              "type": "string",
              "description": "Team alias, recorded on the grant for display.",
              "maxLength": 200
            },
            "email": {
              "type": "string",
              "description": "Optional contact email for the LiteLLM user.",
              "maxLength": 320
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "uri": { "type": "string" },
            "rkey": { "type": "string" }
          }
        }
      }
    }
  }
}
