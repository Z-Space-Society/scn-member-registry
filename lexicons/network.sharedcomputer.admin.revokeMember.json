{
  "lexicon": 1,
  "id": "network.sharedcomputer.admin.revokeMember",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Revoke a membership. Caller must be a current admin in the roster. Writes a revocation to the registry space, authored by the calling admin.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["did"],
          "properties": {
            "did": { "type": "string", "format": "did" },
            "reason": {
              "type": "string",
              "description": "Optional note recorded on the revocation.",
              "maxLength": 300
            }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" },
            "uri": { "type": "string" },
            "rkey": { "type": "string" }
          }
        }
      }
    }
  }
}
