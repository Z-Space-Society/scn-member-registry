{
  "lexicon": 1,
  "id": "network.sharedcomputer.membership.getMyUsage",
  "defs": {
    "main": {
      "type": "query",
      "description": "The caller's own gateway usage, from LiteLLM's daily tables.",
      "parameters": {
        "type": "params",
        "properties": {
          "startDate": { "type": "string", "description": "YYYY-MM-DD, defaults to 29 days ago" },
          "endDate": { "type": "string", "description": "YYYY-MM-DD, defaults to today" }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["rows", "totals", "startDate", "endDate"],
          "properties": {
            "rows": { "type": "array", "items": { "type": "unknown" } },
            "totals": { "type": "unknown" },
            "startDate": { "type": "string" },
            "endDate": { "type": "string" }
          }
        }
      }
    }
  }
}
