{
  "lexicon": 1,
  "id": "network.sharedcomputer.membership.syncProfile",
  "defs": {
    "main": {
      "type": "procedure",
      "description": "Refresh the caller's display details on their own LiteLLM user: handle as user_alias, email as user_email.",
      "input": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "properties": {
            "email": { "type": "string", "maxLength": 320 },
            "handle": { "type": "string", "maxLength": 253 }
          }
        }
      },
      "output": {
        "encoding": "application/json",
        "schema": {
          "type": "object",
          "required": ["ok"],
          "properties": {
            "ok": { "type": "boolean" }
          }
        }
      }
    }
  }
}
